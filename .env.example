PORT=3000
ORDER_START=1100001
ALLOWED_ORIGIN=https://barkatbooks.com

# Facebook Lead Ads webhook
FB_VERIFY_TOKEN=pick-any-secret-string
FB_APP_SECRET=
FB_PAGE_TOKEN=

# Shopify (Admin API token needs write_orders)
# SHOPIFY_STORE=your-store.myshopify.com
# SHOPIFY_TOKEN=shpat_xxx
# SHOPIFY_VARIANT_ID=1234567890
# SHOPIFY_COUNTRY=Pakistan
LEAD_API_KEY=

# All Pages: long-lived user token of the account that manages them (server derives each Page token itself)
FB_USER_TOKEN=
# Secret for /api/subscribe-all (subscribes every Page to the app)
ADMIN_KEY=
# Optional: different product per Page, JSON {"pageId":"variantId"}
PAGE_VARIANTS=
# Needed so the server can renew the user token by itself (Meta app dashboard > Settings > Basic > App ID)
FB_APP_ID=
# Optional: extra user tokens (comma separated) from other accounts that manage other Pages
FB_USER_TOKENS=
# Shopify Dev Dashboard apps: use these two instead of SHOPIFY_TOKEN
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
